# Base URL of the yt-dlp scraper service (see /scraper), no trailing slash.
# When unset, /api/extract uses only its built-in extractors.
SCRAPER_SERVICE_URL=https://your-scraper.onrender.com

# Public contact address shown on /contact
NEXT_PUBLIC_CONTACT_EMAIL=contact@savereelsfast.com

# Optional shared secret. Set the SAME value on the scraper service so only this
# app can call /extract and /download.
SCRAPER_SHARED_SECRET=

# --- Advertising -------------------------------------------------------------
# Leave everything unset to show quiet "Advertisement" placeholders. These values are
# inlined at build time, so change them in Vercel and redeploy.
#
# Google AdSense
# NEXT_PUBLIC_AD_CLIENT_ID=ca-pub-1234567890123456
# NEXT_PUBLIC_AD_SLOT_LEADERBOARD=1111111111
# NEXT_PUBLIC_AD_SLOT_NATIVE=2222222222
# NEXT_PUBLIC_AD_SLOT_STICKY=3333333333
#
# A-ADS (set NEXT_PUBLIC_AD_PROVIDER=aads; slots are A-ADS unit ids, *_MOBILE are optional 320x50 units)
# NEXT_PUBLIC_AD_PROVIDER=aads
# NEXT_PUBLIC_AD_SLOT_LEADERBOARD=2000001
# NEXT_PUBLIC_AD_SLOT_LEADERBOARD_MOBILE=2000002
# NEXT_PUBLIC_AD_SLOT_NATIVE=2000003
# NEXT_PUBLIC_AD_SLOT_STICKY=2000004
# NEXT_PUBLIC_AD_SLOT_STICKY_MOBILE=2000005
#
# Any other network (Propeller, Adsterra, ...): paste its snippet, scripts included
# NEXT_PUBLIC_AD_PROVIDER=custom
# NEXT_PUBLIC_AD_HTML_LEADERBOARD=<div id="..."></div><script async src="https://..."></script>
# NEXT_PUBLIC_AD_HTML_NATIVE=...
# NEXT_PUBLIC_AD_HTML_STICKY=...
#
# Hide the empty placeholder boxes while no network is configured
# NEXT_PUBLIC_AD_PLACEHOLDERS=off

# Address on the DMCA page for copyright notices (defaults to NEXT_PUBLIC_CONTACT_EMAIL)
# NEXT_PUBLIC_DMCA_EMAIL=dmca@savereelsfast.com
