# Public build-time settings for production. Vercel environment variables override these.
# (Nothing secret belongs here: NEXT_PUBLIC_* values end up in the page HTML anyway.)

# A-ADS banner unit -> under the hero/search box (leaderboard) and under the download result (native)
NEXT_PUBLIC_AD_PROVIDER=aads
NEXT_PUBLIC_AD_SLOT_LEADERBOARD=2455819
NEXT_PUBLIC_AD_SLOT_NATIVE=2455819

# Don't show empty "Advertisement" boxes for slots that have no unit yet (the sticky banner).
# Remove this line, or add NEXT_PUBLIC_AD_SLOT_STICKY, to fill that slot too.
NEXT_PUBLIC_AD_PLACEHOLDERS=off

# Google Analytics 4 (measurement ID). Loaded only after a visitor accepts the analytics banner; leave out to switch it off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-QZOZ9KJ7MH

# Monetag Vignette banner (zone from Monetag's dashboard). Loaded only after a visitor accepts the cookie banner; leave out to switch it off.
NEXT_PUBLIC_MONETAG_ZONE=11851975
